# Port the app is published on (Render sets PORT itself).
PORT=3000

# Local Postgres container (docker-compose.yml).
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=vulndemo

# Used when running outside compose. Compose overrides it to point at the "db"
# service. On Render, set it to the Render Postgres "Internal Database URL".
DATABASE_URL=postgresql://app:app@localhost:5432/vulndemo

# Long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m

# This account gets the "admin" role. Created on every start by prisma/seed.js.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
